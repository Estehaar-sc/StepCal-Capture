<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF9F5">

    <!-- COMPACT TOP BAR -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="#FFFFFF"
        android:elevation="3dp">

        <ImageButton
            android:id="@+id/menu_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:contentDescription="Open navigation menu"
            android:tint="#4A174C" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="StepCal"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#4A174C" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step Count"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#333333" />

        </LinearLayout>

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/stepcal_logo"
            android:contentDescription="StepCal logo"
            android:scaleType="centerInside" />

    </LinearLayout>


    <!-- SCROLLABLE CONTENT -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="16dp"
            android:paddingBottom="30dp">


            <!-- PAGE SUBTITLE -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Navigate yourself with StepCal Map"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#777777"
                android:gravity="center"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp" />


            <!-- KEEP STATUS VIEW FOR JAVA -->

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:visibility="gone"
                android:text="READY TO WALK" />


            <!-- REAL MAP -->

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="310dp"
                android:background="@drawable/capture_map_background"
                android:clipToOutline="true"
                android:elevation="3dp">

                <org.maplibre.android.maps.MapView
                    android:id="@+id/mapView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- MY LOCATION -->

                <ImageButton
                    android:id="@+id/mapLocationButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:padding="11dp"
                    android:src="@android:drawable/ic_menu_mylocation"
                    android:background="@drawable/capture_location_button"
                    android:scaleType="centerInside"
                    android:tint="#4A174C"
                    android:clickable="true"
                    android:focusable="true"
                    android:elevation="6dp"
                    android:contentDescription="Show my current location" />

                <!-- ZOOM BUTTONS -->

                <LinearLayout
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="12dp"
                    android:orientation="vertical"
                    android:elevation="6dp">

                    <TextView
                        android:id="@+id/zoomInButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="+"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#4A174C"
                        android:background="@drawable/capture_label_background"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Zoom in" />

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="5dp" />

                    <TextView
                        android:id="@+id/zoomOutButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="−"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#4A174C"
                        android:background="@drawable/capture_label_background"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Zoom out" />

                </LinearLayout>

            </FrameLayout>


            <!-- MAP INSTRUCTION -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Drag the map, pinch to zoom, or use the controls."
                android:textSize="12sp"
                android:textColor="#888888"
                android:gravity="center"
                android:layout_marginTop="9dp"
                android:layout_marginBottom="10dp" />


            <!-- START / STOP -->

            <TextView
                android:id="@+id/startButton"
                android:layout_width="240dp"
                android:layout_height="56dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="START WALK"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/capture_start_button"
                android:clickable="true"
                android:focusable="true" />


            <!-- LIVE STAT CARDS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="18dp">


                <!-- STEPS -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/capture_info_background">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="STEPS"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#6D4B12"
                        android:background="#FFF0CC" />

                    <TextView
                        android:id="@+id/stepsValue"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:gravity="center"
                        android:text="0"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#4A174C"
                        android:background="#FFFFFF" />

                </LinearLayout>


                <!-- DISTANCE -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/capture_info_background">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="DISTANCE"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#5B3D73"
                        android:background="#F1E7FA" />

                    <TextView
                        android:id="@+id/distanceValue"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:gravity="center"
                        android:text="0.00 km"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="#4A174C"
                        android:background="#FFFFFF" />

                </LinearLayout>


                <!-- BURNED CALORIES -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/capture_info_background">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="BURNED CALORIES"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="#7A4141"
                        android:background="#FDE5E1"
                        android:maxLines="1"
                        android:ellipsize="none" />

                    <TextView
                        android:id="@+id/caloriesValue"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:gravity="center"
                        android:text="0 kcal"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="#4A174C"
                        android:background="#FFFFFF" />

                </LinearLayout>

            </LinearLayout>


            <!-- WALK DURATION -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/capture_info_background">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="WALK DURATION"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#777777" />

                <TextView
                    android:id="@+id/durationValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#4A174C" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>