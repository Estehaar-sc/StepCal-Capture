<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main screen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#FFF9F5">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:background="#FFFFFF"
            android:elevation="4dp">

            <ImageButton
                android:id="@+id/menu_button"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:tint="#4A174C"
                android:contentDescription="Open navigation menu" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="StepCal"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="#4A174C" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Activity Level"
                    android:textSize="13sp"
                    android:textColor="#888888" />

            </LinearLayout>

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/stepcal_logo"
                android:scaleType="centerInside"
                android:contentDescription="StepCal logo" />

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your Activity Level"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="#4A174C"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/current_level"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Choose the level that best matches your daily activity."
                    android:textSize="15sp"
                    android:textColor="#777777"
                    android:layout_marginBottom="22dp" />

                <RadioGroup
                    android:id="@+id/activityLevelRadioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/low"
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:text="Low"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:buttonTint="#6A2C70" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mostly sedentary or little structured exercise."
                        android:textSize="13sp"
                        android:textColor="#888888"
                        android:paddingStart="52dp"
                        android:paddingBottom="10dp" />

                    <RadioButton
                        android:id="@+id/moderate"
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:text="Moderate"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:buttonTint="#6A2C70" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Regular walking, workouts, or active daily routines."
                        android:textSize="13sp"
                        android:textColor="#888888"
                        android:paddingStart="52dp"
                        android:paddingBottom="10dp" />

                    <RadioButton
                        android:id="@+id/high"
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:text="High"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:buttonTint="#6A2C70" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Frequent exercise or an active lifestyle."
                        android:textSize="13sp"
                        android:textColor="#888888"
                        android:paddingStart="52dp"
                        android:paddingBottom="10dp" />

                    <RadioButton
                        android:id="@+id/extreme"
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:text="Extreme"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:buttonTint="#6A2C70" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Very demanding training or highly active daily routines."
                        android:textSize="13sp"
                        android:textColor="#888888"
                        android:paddingStart="52dp"
                        android:paddingBottom="20dp" />

                </RadioGroup>

                <Button
                    android:id="@+id/submit"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Save Activity Level"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#6A2C70" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <!-- Navigation Drawer -->
    <LinearLayout
        android:id="@+id/navigation_drawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#4A174C">

            <ImageView
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:src="@drawable/stepcal_logo"
                android:scaleType="centerInside"
                android:contentDescription="StepCal logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="StepCal"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Move better. Live better."
                android:textSize="13sp"
                android:textColor="#F7DDF8"
                android:layout_marginTop="3dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="14dp">

            <TextView
                android:id="@+id/nav_profile"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:text="👤   My Profile"
                android:textSize="16sp"
                android:textColor="#333333"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/nav_tasks"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:text="🎯   Today's Tasks"
                android:textSize="16sp"
                android:textColor="#333333"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/nav_goal"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:text="🏆   My Goals"
                android:textSize="16sp"
                android:textColor="#333333"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/nav_activity"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:text="🏃   Activity Level"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#4A174C"
                android:background="?attr/selectableItemBackground" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginTop="10dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/nav_logout"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:text="🚪   Log Out"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#C62828"
            android:background="?attr/selectableItemBackground" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>