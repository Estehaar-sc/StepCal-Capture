<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F5"
    android:fillViewport="true"
    tools:context=".Activity.Progress">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- COMPACT TOP BAR -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:elevation="3dp">

            <ImageButton
                android:id="@+id/menu_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:contentDescription="Open navigation menu"
                android:tint="#4A174C" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="StepCal"
                    android:textColor="#4A174C"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today's Progress"
                    android:textColor="#302534"
                    android:textSize="19sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/stepcal_logo"
                android:contentDescription="StepCal logo"
                android:scaleType="centerInside" />

        </LinearLayout>


        <!-- MAIN CONTENT -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="18dp">

            <!-- TODAY'S PROGRESS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/capture_info_background"
                android:backgroundTint="#6F35A8"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="15dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TODAY'S PROGRESS"
                    android:textColor="#F5EAFE"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.example.stepcal.Activity.ProgressGaugeView
                    android:id="@+id/todayProgressGauge"
                    android:layout_width="match_parent"
                    android:layout_height="145dp"
                    android:layout_marginTop="0dp" />

                <TextView
                    android:id="@+id/progressStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-2dp"
                    android:text="Loading today's progress..."
                    android:textColor="#F5EAFE"
                    android:textSize="12sp" />

            </LinearLayout>


            <!-- TODAY'S GOAL -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Today's Goal"
                android:textColor="#24152F"
                android:textSize="21sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/capture_info_background"
                android:backgroundTint="#FFFFFF"
                android:orientation="vertical"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/todayGoalStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loading today's goal..."
                    android:textColor="#24152F"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/todayGoalDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Loading..."
                    android:textColor="#806B82"
                    android:textSize="12sp" />

            </LinearLayout>


            <!-- TODAY'S CALORIES -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Today's Calories"
                android:textColor="#24152F"
                android:textSize="21sp"
                android:textStyle="bold" />


            <!-- DAILY CALORIE GOAL -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="108dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/capture_info_background"
                android:backgroundTint="#F1E7FA"
                android:orientation="vertical"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:paddingTop="11dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/dailyCalorieGoalTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎯 Daily Calorie Goal"
                    android:textColor="#5B3D73"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dailyCalorieGoal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="0 kcal"
                    android:textColor="#6F35A8"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dailyCalorieGoalStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Loading..."
                    android:textColor="#806B82"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- CALORIES BURNED -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="108dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/capture_info_background"
                android:backgroundTint="#FDE5E1"
                android:orientation="vertical"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:paddingTop="11dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔥 Calories Burned"
                    android:textColor="#7A4141"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/burnedCalories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="0.00 kcal"
                    android:textColor="#B85C5C"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/workoutStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Workout not completed"
                    android:textColor="#806B82"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- CALORIES EATEN -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="108dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/capture_info_background"
                android:backgroundTint="#FFF0CC"
                android:orientation="vertical"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:paddingTop="11dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🍽️ Calories Eaten"
                    android:textColor="#6D4B12"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/foodCaloriesProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="0 kcal"
                    android:textColor="#A87920"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/foodCaloriesStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Loading..."
                    android:textColor="#806B82"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- TODAY'S SUGGESTION -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Today's Suggestion"
                android:textColor="#24152F"
                android:textSize="21sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/capture_info_background"
                android:backgroundTint="#FFF0E8"
                android:orientation="vertical"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/todaySuggestionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💡 Your daily update"
                    android:textColor="#24152F"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/todaySuggestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Loading today's suggestion..."
                    android:textColor="#66596A"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>


            <!-- TOMORROW'S SUGGESTED PROGRESS -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Tomorrow's Suggested Progress"
                android:textColor="#24152F"
                android:textSize="21sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/capture_info_background"
                android:backgroundTint="#EAF5EF"
                android:orientation="vertical"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/tomorrowTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🌅 Your next day"
                    android:textColor="#315C46"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tomorrowSuggestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Loading tomorrow's suggestion..."
                    android:textColor="#66596A"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>