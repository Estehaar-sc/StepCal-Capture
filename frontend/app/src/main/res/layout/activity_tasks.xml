<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F5"
    android:fillViewport="true"
    tools:context=".Activity.Tasks">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- COMPACT TOP BAR -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:elevation="3dp">

            <ImageButton
                android:id="@+id/menu_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:contentDescription="Open navigation menu"
                android:tint="#4A174C" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="StepCal"
                    android:textColor="#4A174C"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today's Plan"
                    android:textColor="#302534"
                    android:textSize="19sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/stepcal_logo"
                android:contentDescription="StepCal logo"
                android:scaleType="centerInside" />

        </LinearLayout>


        <!-- MAIN CONTENT -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="20dp">

            <!-- DAILY FOOD CALORIE GOAL -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:background="@drawable/capture_info_background"
                android:backgroundTint="#F1E7FA"
                android:elevation="2dp"
                android:orientation="vertical"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:paddingTop="10dp"
                android:paddingBottom="9dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DAILY FOOD CALORIE GOAL"
                    android:textColor="#5B3D73"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/target"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="0 kcal"
                    android:textColor="#6F35A8"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aim to eat around this amount today"
                    android:textColor="#806B82"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- WORKOUT CALORIES -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/capture_info_background"
                android:backgroundTint="#FDE5E1"
                android:elevation="2dp"
                android:orientation="vertical"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:paddingTop="9dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 WORKOUT CALORIES BURNED"
                    android:textColor="#7A4141"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/workoutCalories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="0.00 kcal"
                    android:textColor="#B85C5C"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calories burned from today's workout"
                    android:textColor="#806B82"
                    android:textSize="10sp" />

            </LinearLayout>


            <!-- WORKOUT -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="Workout"
                android:textColor="#24152F"
                android:textSize="22sp"
                android:textStyle="bold" />


            <!-- EXERCISE AREA -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/capture_info_background"
                android:backgroundTint="#FFFFFF"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Today's Exercises"
                    android:textColor="#24152F"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- COMPACT INTERNAL SCROLL AREA -->

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="8dp"
                    android:fillViewport="false"
                    android:nestedScrollingEnabled="true"
                    android:scrollbars="vertical">

                    <GridLayout
                        android:id="@+id/exerciseGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:orientation="horizontal"
                        android:padding="2dp"
                        android:useDefaultMargins="false">

                    </GridLayout>

                </ScrollView>

            </LinearLayout>


            <!-- COMPLETE WORKOUT -->

            <TextView
                android:id="@+id/completeWorkoutButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/capture_info_background"
                android:backgroundTint="#6F35A8"
                android:gravity="center"
                android:text="✓  Mark Workout Complete"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />


            <!-- ADD EXERCISE -->

            <TextView
                android:id="@+id/addExerciseButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/capture_info_background"
                android:backgroundTint="#FFF0E8"
                android:gravity="center"
                android:text="+  Add Exercise"
                android:textColor="#6F35A8"
                android:textSize="14sp"
                android:textStyle="bold" />


            <!-- FOOD TODAY -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="Food Today"
                android:textColor="#24152F"
                android:textSize="22sp"
                android:textStyle="bold" />


            <!-- FOOD CARD -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="126dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/capture_info_background"
                android:backgroundTint="#FFF0CC"
                android:elevation="2dp"
                android:orientation="vertical"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:paddingTop="10dp"
                android:paddingBottom="9dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🍽️ Today's food intake"
                    android:textColor="#6D4B12"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/foodCaloriesToday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="0 kcal"
                    android:textColor="#A87920"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/foodCaloriesRemaining"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:text="Loading your food goal..."
                    android:textColor="#806B82"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/foodCaloriesInput"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/capture_info_background"
                    android:backgroundTint="#FFFFFF"
                    android:hint="Calories eaten"
                    android:inputType="numberDecimal"
                    android:paddingStart="11dp"
                    android:paddingEnd="11dp"
                    android:textColor="#24152F"
                    android:textColorHint="#9A8D9D"
                    android:textSize="12sp" />

            </LinearLayout>


            <!-- ADD FOOD -->

            <TextView
                android:id="@+id/addFoodButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/capture_info_background"
                android:backgroundTint="#FFF0E8"
                android:gravity="center"
                android:text="+  Add Food Calories"
                android:textColor="#6F35A8"
                android:textSize="14sp"
                android:textStyle="bold" />


            <!-- STAY CONSISTENT -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/capture_info_background"
                android:backgroundTint="#F7F1F8"
                android:orientation="vertical"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💡 Stay consistent"
                    android:textColor="#24152F"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Complete your exercises and keep your food intake close to your daily goal."
                    android:textColor="#66596A"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>